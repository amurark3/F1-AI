// Config for the "Frontend npm audit" CI job (.github/workflows/dependency-audit.yml).
// audit-ci wraps `npm audit` and adds the one thing it lacks: a scoped allowlist.
// Run locally from frontend/: npx audit-ci@7.1.0 --config audit-ci.jsonc
{
  // Same bar as the old `npm audit --audit-level=high`: fail on high + critical.
  "high": true,
  "report-type": "summary",
  // Advisories with no published fix, each scoped to the one dependency path
  // that brings it in ("GHSA-xxxx|parent>*") so the same package arriving any
  // other way still fails the gate. Give every entry a comment saying why it is
  // tolerated, and delete it once audit-ci logs "Consider not allowlisting
  // path" for it.
  "allowlist": [],
}
