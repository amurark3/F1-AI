# OS files
.DS_Store
Thumbs.db

# Bytecode, wherever it lands. `.githooks/` gets a __pycache__ because the hook
# reporter is imported by tests/test_githooks_ruff_gate_report.py.
__pycache__/

# Python Backend
backend/venv/
backend/.venv/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/f1_cache/
backend/.pytest_cache/
backend/.ruff_cache/
# Coverage artefacts. The `.coverage` data file is a binary SQLite database
# rewritten on every run, so tracking it means a spurious diff per test run;
# `reports/` holds the XML/HTML renderings configured in .coveragerc.
backend/.coverage
backend/.coverage.*
backend/reports/
# Local ChromaDB is obsolete — rulebook vectors now live in Postgres/pgvector.
# Any leftover local build is ignored.
backend/data/chroma/
# Ignore stray/experiment model artifacts but track the production model so it
# ships with deploys (Render's filesystem is ephemeral).
backend/models/*.joblib
!backend/models/race_predictor.joblib

# Node Frontend
frontend/node_modules/
frontend/.next/
frontend/.env
frontend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Xcode user state
ios/**/*.xcuserstate
ios/**/xcuserdata/

# Runtime data
backend/data/prediction_history.json
backend/data/prediction_cache.json
# Pre-write copies of the prediction documents taken by scripts/backfill_predictions.py
backend/data/backups/
# Local fallback for the durable circuit strategy reference cache (Supabase in
# production) — machine-local telemetry summaries, recreated on demand.
backend/data/circuit_reference.json

# Downloaded / generated ML + reference datasets (recreated on demand)
backend/data/f1db.db
# Records which f1db release the local database came from — written beside it
# by f1db_source, and as machine-local as the database itself.
backend/data/f1db.db.version
backend/data/training_dataset.csv

# Claude Code project data
.claude/
