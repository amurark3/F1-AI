[Unit]
Description=F1 AI: point the DuckDNS name at this VM's IP
Documentation=https://github.com/amurark3/F1-AI/tree/main/deploy/oracle
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/f1ai

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/f1ai/app/deploy/oracle/bin/duckdns.sh
TimeoutStartSec=2min
