[Unit]
Description=F1 AI: re-read every power-unit event page of the season
Documentation=https://github.com/amurark3/F1-AI/tree/main/deploy/oracle
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/f1ai

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/f1ai/app/deploy/oracle/bin/pu-ingest.sh --all-events
TimeoutStartSec=50min
