# Backend API URL (defaults to localhost:8000 for local development)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: backend origin used by server-side rendering only. Set this to an
# internal address to keep server renders off the public edge. Falls back to
# NEXT_PUBLIC_API_URL when unset, which is correct for most deployments.
# API_URL=http://localhost:8000

# Optional: Sentry error tracking (app/lib/errorTracking.ts). Off when unset.
# The DSN is in Sentry under Settings → Projects → <project> → Client Keys (DSN).
# It ships to every browser, so it is not a secret — but it is read at build
# time: redeploy after changing it.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>

# Optional, build-time only: upload source maps so Sentry shows readable stack
# traces. SENTRY_AUTH_TOKEN IS a secret — set it in the Vercel dashboard, never here.
# SENTRY_ORG=personal-1tc
# SENTRY_PROJECT=<project-slug>
# SENTRY_AUTH_TOKEN=
