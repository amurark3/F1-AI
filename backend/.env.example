# Chat engines — set at least one; set both so the chat keeps answering when
# one fails (out of points/credit, rate-limited, down). Tried in this order:
#
# AMD Token Lab — the primary engine. Join the AMD AI Developer Program, then
# get a key at https://notebooks.amd.com/tokenlab. It is a beta: a points budget
# and a 30-day access window you extend by hand from that page.
TOKENLAB_API_KEY=your_tokenlab_api_key
#
# Gemini — the fallback engine, free tier. Create the key at
# https://aistudio.google.com in a project with NO billing linked: a key on a
# billing-enabled project is charged (or refused with 402 once prepaid credit
# runs out) instead of using the free tier.
GOOGLE_API_KEY=your_gemini_api_key
#
# NOTE: only the keys belong here. The models are not configuration — they are
# code constants, LLM_PROVIDERS in app/config.py.

# Tavily web-search API key — optional (powers the perform_web_search tool).
# https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key

# OpenWeatherMap API key — optional (powers the get_weather_conditions tool).
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Postgres connection string with the pgvector extension — optional.
# Enables durable prediction/accuracy storage and per-user conversation memory.
# Leave unset to fall back to local JSON files and disable memory.
#
# USE THE POOLER HOST, NOT THE DIRECT ONE. Supabase's direct endpoint
# (db.<project-ref>.supabase.co) publishes no A record — it is IPv6-only — and
# hosts with IPv4-only egress, Render and GitHub Actions runners among them,
# cannot reach it at all. The failure is silent from the outside: the app keeps
# serving, backed by an ephemeral local file that every cold start erases.
# The Supavisor pooler is dual-stack. Find yours under
# Supabase → Project Settings → Database → Connection string → Session pooler.
#
# Session mode (port 5432) is what this app wants: psycopg promotes statements
# to prepared ones, which transaction mode (port 6543) rejects unless you also
# set prepare_threshold=None.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Load torch models (sentence-transformers embedder + cross-encoder reranker)
# inside the web process. Off by default.
#
# These power rulebook search and conversation-memory recall. Loading them costs
# a few hundred MB, which a 512MB Render instance does not have — in production
# one rulebook query OOM-killed the container and took every endpoint down for
# minutes. An OOM cannot be caught, so the graceful fallbacks never ran.
#
# Set true locally (and in the ingest job) where the memory exists. With it off,
# chat still works and messages are still stored — only semantic recall is
# skipped — and rulebook search reports honestly that it is disabled.
ENABLE_LOCAL_MODELS=true

# Comma-separated allowed CORS origins (set to your Vercel frontend URL in production).
ALLOWED_ORIGINS=http://localhost:3000
