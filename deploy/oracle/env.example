# /srv/f1ai/.env on the Oracle VM: every setting and secret the stack needs.
# A template: values here are empty or placeholders, never real ones.
#
#   sudo install -o deploy -g deploy -m 600 /srv/f1ai/app/deploy/oracle/env.example /srv/f1ai/.env
#   sudo -u deploy nano /srv/f1ai/.env
#
# Mode 600, owner deploy: Docker Compose reads it as the deploy user, and the
# timers' scripts read DUCKDNS_* and OCI_* from it. Never commit the filled-in
# file, paste it into chat, or put it anywhere but the VM.
#
# Format (Docker Compose env file): KEY=value, one per line, no spaces around
# "=". Compose expands $ in unquoted and double-quoted values, so wrap a value
# that contains $ in single quotes.
#
# The image already sets ENABLE_LOCAL_MODELS=true, FASTF1_CACHE_DIR, HF_HOME,
# F1DB_PATH and GIT_COMMIT (backend/Dockerfile); don't repeat them here.

# --- The VM's own services ---------------------------------------------------

# Postgres superuser password, read once when /srv/f1ai/pgdata is first
# initialised. Generate it on the VM: openssl rand -hex 32
# (hex needs no URL escaping in DATABASE_URL below).
POSTGRES_PASSWORD=

# The API's database: the same password as POSTGRES_PASSWORD, on the Compose
# service name "postgres" (the app classifies it as self-hosted).
# DATABASE_URL=postgresql://f1ai:<POSTGRES_PASSWORD>@postgres:5432/f1ai
DATABASE_URL=

# The public name Caddy serves and gets a certificate for: the DuckDNS name
# from docs/deploy/ORACLE.md §1.6, e.g. <name>.duckdns.org (no https://).
API_HOST=

# DuckDNS refresh (systemd timer f1ai-duckdns, every 5 minutes).
# DUCKDNS_DOMAIN: the subdomain only, <name> (".duckdns.org" is also accepted).
# DUCKDNS_TOKEN: the token at the top of duckdns.org once you sign in.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Nightly pg_dump upload (systemd timer f1ai-backup), with instance-principal
# auth (ORACLE.md §1.7), so no OCI key lives on the VM.
# OCI_NAMESPACE: Object Storage namespace (Profile menu → Tenancy → Object
# storage namespace). Left empty, the backup asks OCI for it.
OCI_BUCKET=f1ai-backups
OCI_NAMESPACE=

# --- The API (the same variables Render's dashboard holds; see render.yaml) ---

# Labels logs (JSON lines) and Sentry events.
ENVIRONMENT=production

# CORS: the frontend's origin(s), comma-separated, no trailing slash,
# e.g. https://<your-app>.vercel.app
ALLOWED_ORIGINS=

# Chat engines: set both so a lapsed engine fails over to the other
# (app/config.py LLM_PROVIDERS). TOKENLAB_API_KEY: AMD Token Lab (primary).
# GOOGLE_API_KEY: Gemini, from a project with no billing account (fallback).
TOKENLAB_API_KEY=
GOOGLE_API_KEY=

# Optional: the web search tool (tavily.com).
TAVILY_API_KEY=

# Optional: the weather tool and current-conditions fallback
# (openweathermap.org). The session forecast itself is Open-Meteo, keyless.
OPENWEATHERMAP_API_KEY=

# Optional: Sentry error tracking, the backend project's DSN (not the
# frontend's). Off when empty.
SENTRY_DSN=

# Optional: faster, rate-limit-free model downloads from Hugging Face. The
# models are cached under /srv/f1ai/huggingface after the first download.
HF_TOKEN=

# Optional: a GitHub token with no scopes. Raises the f1db release lookup's
# GitHub API limit from 60 to 5,000 requests an hour (app/data/f1db_source.py).
GITHUB_TOKEN=
